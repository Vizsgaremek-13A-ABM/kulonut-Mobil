<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:kulonut_Mobil.Views">
    
    
    <Style TargetType="Label" x:Key="AuthHeader1">
        <Setter Property="TextColor" Value="{StaticResource DarkGray}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Label" x:Key="AuthLabel">
        <Setter Property="TextColor" Value="{StaticResource DarkGray}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="5, 0, 0, 3"/>
    </Style>
    <Style TargetType="Label" x:Key="CheckboxLabel">
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Button" x:Key="AuthButton">
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style TargetType="ImageButton" x:Key="UserEditButton">
        <Setter Property="TranslationY" Value="3"/>
        <Setter Property="TranslationX" Value="3"/>
        <Setter Property="VerticalOptions" Value="Start"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="WidthRequest" Value="20"/>
        <Setter Property="HeightRequest" Value="20"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>
    <Style TargetType="Border" x:Key="BlockBorder">
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style TargetType="Border" x:Key="AuthBorder">
        <Setter Property="Margin" Value="0, 5"/>
        <Setter Property="Padding" Value="12, 4"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
    </Style>
    <Style TargetType="Border" x:Key="UserIconEditBorder">
        <Setter Property="VerticalOptions" Value="Start"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="TranslationX" Value="-20"/>
        <Setter Property="TranslationY" Value="20"/>
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Background" Value="{StaticResource LightestGray}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Shadow" Value="{Shadow Brush=Black, Offset='0,2', Opacity=0.3}"/>
    </Style>
    <Style TargetType="Border" x:Key="UserDetailsIconBorder">
        <Setter Property="Margin" Value="0, 20, 0, 0"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 100"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="WidthRequest" Value="200"/>
        <Setter Property="HeightRequest" Value="200"/>
    </Style>
    <Style TargetType="Entry" x:Key="AuthEntry">
        <Setter Property="FontSize" Value="16"/> 
        <Setter Property="HeightRequest" Value="40"/> 
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox" x:Key="DetailsCheckbox">
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="Color" Value="{StaticResource DarkGray}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style TargetType="views:AuthEntry">
        <Setter Property="FocusColor" Value="{StaticResource Primary}"/>
        <Setter Property="UnFocusColor" Value="{StaticResource LightestGray}"/>
    </Style>
</ResourceDictionary>
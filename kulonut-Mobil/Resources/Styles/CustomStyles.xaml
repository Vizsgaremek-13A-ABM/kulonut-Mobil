<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:kulonut_Mobil.Views">
    
    
    <Style TargetType="Label" x:Key="AuthHeader1">
        <Setter Property="TextColor" Value="{StaticResource DarkGray}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Label" x:Key="AuthLabel">
        <Setter Property="TextColor" Value="{StaticResource LightestGray}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="5, 0, 0, 3"/>
    </Style>
    <Style TargetType="Label" x:Key="HeaderLine2" BasedOn="{StaticResource AuthHeader1}">
        <Setter Property="VerticalOptions" Value="End"/>
        <Setter Property="Margin" Value="0, 0, 0, 30"/>
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource AuthLabel}" x:Key="ForgotPasswordLabel">
        <Setter Property="Text" Value="Elfelejtett jelszó"/>
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style TargetType="Label" x:Key="CheckboxLabel">
        <Setter Property="TextColor" Value="{StaticResource MidGray}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Label" x:Key="ErrorLabel">
        <Setter Property="TextColor" Value="{StaticResource ErrorColor}"/>
        <Setter Property="Margin" Value="0, 5"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Label" x:Key="FilterHideLabel">
        <Setter Property="Text" Value="Válassz dátumot"/>
        <Setter Property="TextColor" Value="{StaticResource MidGray}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style TargetType="Label" x:Key="PopupHeaderLabel">
        <Setter Property="TextColor" Value="{StaticResource LightestGray}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Label" x:Key="MenuLabel">
        <Setter Property="Padding" Value="25"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Grid.Column" Value="1"/>
    </Style>
    <Style TargetType="Label" x:Key="FilterLabel" BasedOn="{StaticResource AuthLabel}">
        <Setter Property="Margin" Value="0, 15, 0, 0"/>
    </Style>
    <Style TargetType="Button" x:Key="AuthButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style TargetType="Button" x:Key="PopupButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}"/>
        <Setter Property="WidthRequest" Value="100"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PopupButton}" x:Key="QuitPopupButton">
        <Setter Property="WidthRequest" Value="80"/>
        <Setter Property="HeightRequest" Value="35"/>
    </Style>
    <Style TargetType="ImageButton" x:Key="UserEditButton">
        <Setter Property="TranslationY" Value="3"/>
        <Setter Property="TranslationX" Value="3"/>
        <Setter Property="VerticalOptions" Value="Start"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="WidthRequest" Value="20"/>
        <Setter Property="HeightRequest" Value="20"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>
    <Style TargetType="ImageButton" x:Key="FilterDeleteButton">
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Source" Value="close"/>
        <Setter Property="WidthRequest" Value="25"/>
        <Setter Property="HeightRequest" Value="25"/>
    </Style>
    <Style TargetType="ImageButton" x:Key="MapIconButton">
        <Setter Property="WidthRequest" Value="50"/>
        <Setter Property="HeightRequest" Value="50"/>
    </Style>
    <Style TargetType="ImageButton" x:Key="LocatorIconButton" BasedOn="{StaticResource MapIconButton}">
        <Setter Property="Margin" Value="20"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="VerticalOptions" Value="Start"/>
    </Style>
    <Style TargetType="Border" x:Key="BlockBorderDark">
        <Setter Property="BackgroundColor" Value="{StaticResource MidGray}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style TargetType="Border" x:Key="BlockBorderLight" BasedOn="{StaticResource BlockBorderDark}">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
    </Style>
    <Style TargetType="Border" x:Key="AuthBorder">
        <Setter Property="BackgroundColor" Value="White"/>
        <Setter Property="Margin" Value="0, 5"/>
        <Setter Property="Padding" Value="12, 4"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
    </Style>
    <Style TargetType="Border" x:Key="UserIconEditBorder">
        <Setter Property="VerticalOptions" Value="Start"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="TranslationX" Value="-20"/>
        <Setter Property="TranslationY" Value="20"/>
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Background" Value="{StaticResource LightestGray}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Shadow" Value="{Shadow Brush=Black, Offset='0,2', Opacity=0.3}"/>
    </Style>
    <Style TargetType="Border" x:Key="UserDetailsIconBorder">
        <Setter Property="Margin" Value="0, 20, 0, 0"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 100"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="WidthRequest" Value="200"/>
        <Setter Property="HeightRequest" Value="200"/>
    </Style>
    <Style TargetType="Border" x:Key="PopupBorder">
        <Setter Property="WidthRequest" Value="350"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 30"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="BackgroundColor" Value="{StaticResource MidGray}"/>
    </Style>
    <Style TargetType="DatePicker" x:Key="FilterDate">
        <Setter Property="TextColor" Value="{StaticResource MidGray}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Format" Value="yyyy/MM/dd"/>
    </Style>
    <Style TargetType="Entry" x:Key="AuthEntry">
        <Setter Property="TextColor" Value="{StaticResource DarkGray}"/>
        <Setter Property="FontSize" Value="16"/> 
        <Setter Property="HeightRequest" Value="40"/> 
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox" x:Key="DetailsCheckbox">
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="Color" Value="{StaticResource MidGray}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style TargetType="Line" x:Key="MenuLine">
        <Setter Property="Stroke" Value="{StaticResource MidGray}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="X2" Value="1000"/>
        <Setter Property="Grid.ColumnSpan" Value="2"/>
    </Style>
    <Style TargetType="views:AuthEntry">
        <Setter Property="FocusColor" Value="{StaticResource Primary}"/>
        <Setter Property="UnFocusColor" Value="{StaticResource LightestGray}"/>
    </Style>

</ResourceDictionary>
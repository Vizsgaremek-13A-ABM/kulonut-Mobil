<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kulonut_Mobil.Views.DetailsCheckbox">
    <HorizontalStackLayout>
        <CheckBox VerticalOptions="Center" IsChecked="{Binding IsChecked, Source={RelativeSource AncestorType={x:Type ContentView}}}" HorizontalOptions="Start" Color="{StaticResource DarkGray}" IsEnabled="False"/>
        <Label x:Name="HeaderLabel" VerticalOptions="Center" FontSize="20" FontAttributes="Bold"/>
    </HorizontalStackLayout>
</ContentView>

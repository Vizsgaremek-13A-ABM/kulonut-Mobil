<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kulonut_Mobil.Views.UserEditLabel">
    <VerticalStackLayout Spacing="2" x:Name="ContainerLayout">
        <HorizontalStackLayout>
            <Label x:Name="HeaderLabel" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource LightestGray}"/>
            <ImageButton Source="edit"  Clicked="ImageButton_Clicked" Style="{StaticResource UserEditButton}"/>
        </HorizontalStackLayout>
        <Label x:Name="BodyLabel" TextColor="{StaticResource LightestGray}" Text="{Binding BodyText, Source={RelativeSource AncestorType={x:Type ContentView}}}" FontSize="18" />
    </VerticalStackLayout>
</ContentView>

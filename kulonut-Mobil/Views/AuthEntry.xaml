<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kulonut_Mobil.Views.AuthEntry">
    <VerticalStackLayout>
        <Label x:Name="HeadLabel" Style="{StaticResource AuthLabel}"/>
        <Border Style="{StaticResource AuthBorder}" x:Name="InputBorder">
            <Entry
                Style="{StaticResource AuthEntry}" x:Name="TextInput" Text="{Binding Text, Source={RelativeSource AncestorType={x:Type ContentView}}}"/>
        </Border>
    </VerticalStackLayout>
</ContentView>

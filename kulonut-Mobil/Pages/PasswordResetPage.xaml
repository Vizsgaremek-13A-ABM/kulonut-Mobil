<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kulonut_Mobil.Pages.PasswordResetPage"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             xmlns:pages="clr-namespace:kulonut_Mobil.Pages">
    <ScrollView Margin="20">
        <Grid RowDefinitions="1.2*, *" Margin="0, 100, 0, 0">
            <Border Style="{StaticResource BlockBorderDark}" Grid.Row="0">
                <Grid RowDefinitions="1.5*, 1.5*, *, 0.7*">
                    <Image Source="logo" Grid.Row="0"/>
                    <views:AuthEntry Grid.Row="1" LabelText="Email Cím" Text="{Binding ForgotPasswordRequest.email}" Placeholder="Email Cím"/>
                    <Label Grid.Row="2" VerticalOptions="Center" Margin="0, 0, 0, 30" Text="Adja meg email-címét hogy visszállíthassuk a jelszavát"
                           Style="{StaticResource AuthLabel}"/>
                    <Button Grid.Row="3" Style="{StaticResource AuthButton}" 
                            Text="Visszaállítás megkezdése" Command="{Binding ResetCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</pages:BasePage>
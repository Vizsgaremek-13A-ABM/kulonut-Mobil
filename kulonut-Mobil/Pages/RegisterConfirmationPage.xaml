             xmlns:pages="clr-namespace:kulonut_Mobil.Pages"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             x:Class="kulonut_Mobil.Pages.RegisterConfirmationPage"
             Shell.NavBarIsVisible="False">
   
        
    <Border HeightRequest="300" Margin="20, 40" Style="{StaticResource BlockBorderDark}">
        <VerticalStackLayout Spacing="30">
            <Image Source="logo"/>
            <views:DetailsLabel Spacing="20" HeaderFontSize="26" BodyFontSize="20" HeaderText="Regisztrált" TextColor="{StaticResource LightestGray}" 

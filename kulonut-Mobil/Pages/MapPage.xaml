<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kulonut_Mobil.Pages.MapPage"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             xmlns:pages="clr-namespace:kulonut_Mobil.Pages"
             Title="Térkép Nézet">
    <Shell.TitleView>
        <views:UserHeader Title="Térkép Nézet" RoleText="Admin" NameText="Username" NavigatedFrom="MapPage" ImagePath="splash.png"/>
    </Shell.TitleView>
    <VerticalStackLayout>
        <Label 
            Text="Térkép Nézet"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button Text="Details" Command="{Binding NavigateToDetailsCommand}"/>
    </VerticalStackLayout>
</pages:BasePage>
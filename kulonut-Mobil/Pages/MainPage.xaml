<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             x:Class="kulonut_Mobil.Pages.MainPage"
             xmlns:pages="clr-namespace:kulonut_Mobil.Pages"
             Shell.NavBarIsVisible="False">
    
    
    <ScrollView Margin="20">
        <Grid RowDefinitions="*, *, 4.5*, 1*">
                <Label Grid.Row="0" Text="Különút KFT" Style="{StaticResource AuthHeader1}"/>
            <Label Grid.Row="1" VerticalOptions="End" Margin="0, 0, 0, 30" Text="Bejelentkezés" Style="{StaticResource AuthHeader1}"/>
            <Border Style="{StaticResource BlockBorder}" Grid.Row="2">
                <Grid RowDefinitions="1.2*, 1.2*, *, *, 0.5*, 0.3*">
                    <views:AuthEntry Grid.Row="0" LabelText="Email Cím" Text="" Placeholder="Béla@gmail.com"/>
                    <views:AuthEntry Grid.Row="1" LabelText="Jelszó" IsPassword="True" Placeholder="Password"/>
                    <Button Grid.Row="2" Background="{StaticResource DarkGray}" Style="{StaticResource AuthButton}" Command="{Binding NavigateToMapCommand}" Text="Belépés"/>
                    <Button Grid.Row="3" Background="{StaticResource PrimaryDark}" Style="{StaticResource AuthButton}" Text="Regisztráció"/>
                    <Label Grid.Row="4" VerticalOptions="End" Text="Elfelejtett jelszó" Style="{StaticResource AuthLabel}" TextDecorations="Underline"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>

</pages:BasePage>

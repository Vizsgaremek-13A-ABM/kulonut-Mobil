<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             x:Class="kulonut_Mobil.Pages.MainPage">
    <ScrollView Margin="20">
        <Grid RowDefinitions="*, *, 5*, 0.5*">
            <Label Grid.Row="0" Text="Különút KFT" Style="{StaticResource AuthHeader1}"/>
            <Label Grid.Row="1" VerticalOptions="End" Margin="0, 0, 0, 30" Text="Bejelentkezés" Style="{StaticResource AuthHeader1}"/>
            <Border Style="{StaticResource BlockBorder}" Grid.Row="2">
                <Grid RowDefinitions="1.5*, 1.5*, *, *, 0.5*, 0.3*">
                    <VerticalStackLayout Grid.Row="0">
                        <Label Text="Email Cím" Style="{StaticResource AuthLabel}"/>
                        <views:AuthEntry Placeholder="Béla@gmail.com"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1">
                        <Label Text="Jelszó" Style="{StaticResource AuthLabel}" />
                        <views:AuthEntry IsPassword="True" Placeholder="Password"/>
                    </VerticalStackLayout>
                    <Button Grid.Row="2" Background="{StaticResource DarkGray}" Style="{StaticResource AuthButton}" Text="Belépés"/>
                    <Button Grid.Row="3" Background="{StaticResource PrimaryDark}" Style="{StaticResource AuthButton}" Text="Regisztráció"/>
                    <Label Grid.Row="4" VerticalOptions="End" Text="Elfelejtett jelszó" Style="{StaticResource AuthLabel}" TextDecorations="Underline"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>

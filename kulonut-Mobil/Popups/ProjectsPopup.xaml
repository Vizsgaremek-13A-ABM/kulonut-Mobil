<?xml version="1.0" encoding="utf-8" ?>
<tool:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tool="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:popups="clr-namespace:kulonut_Mobil.Popups"
             x:Class="kulonut_Mobil.Popups.ProjectsPopup"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             Color="Transparent">

    <Border WidthRequest="300" HeightRequest="600" Style="{StaticResource PopupBorder}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Label Grid.Row="0" Text="Projektek az adott területhez" HorizontalOptions="Center" Style="{StaticResource PopupHeaderLabel}"/>
            <CollectionView Grid.Row="1" ItemsSource="{Binding ProjectsByPolygon.projects}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0, 10" Stroke="{StaticResource DarkGray}" Style="{StaticResource BlockBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type popups:ProjectsPopup}}, Path=BindingContext.NavigateToDetailsCommand}"
                                        CommandParameter="{Binding project_id}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <views:DetailsLabel HeaderText="Projekt Neve" BodyText="{Binding name}" Margin="0, 0, 0, 10"/>
                                <views:DetailsLabel HeaderText="Kiadás Dátuma"  BodyText="{Binding plan_issue_date, StringFormat='{0:yyyy.MM.dd}'}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
</tool:Popup>
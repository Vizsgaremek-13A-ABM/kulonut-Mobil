<?xml version="1.0" encoding="utf-8" ?>
<tool:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:kulonut_Mobil.Views"
             x:Class="kulonut_Mobil.Popups.UserEditPopup"
             xmlns:tool="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Color="Transparent">
    <Border Padding="20" WidthRequest="350" StrokeShape="RoundRectangle 30" BackgroundColor="White">
        <Grid Margin="5" RowDefinitions="*, Auto, Auto">
            <views:AuthEntry Grid.Row="0" LabelText="{Binding PropName}" Text="{Binding PropValue}"/>
            <Label Margin="0, 5" Grid.Row="1" Text="{Binding ErrorText}" TextColor="Red" FontSize="16" FontAttributes="Bold"
                IsVisible="{Binding ErrorText, Converter={tool:IsStringNotNullOrEmptyConverter}}" />
            <HorizontalStackLayout Grid.Row="2" Spacing="5">
                <Button Style="{StaticResource ErrorPopupButton}" Command="{Binding SubmitCommand}" Text="Mentés"/>
                <Button Style="{StaticResource ErrorPopupButton}" BackgroundColor="{StaticResource Secondary}" Command="{Binding CancelCommand}" Text="Mégse"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</tool:Popup>